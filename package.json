{
  "name": "opensluice",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "dev": "npm run dev -w @opensluice/gateway",
    "start": "npm run start -w @opensluice/gateway",
    "build": "npm run build -w @opensluice/web",
    "dev:web": "npm run dev -w @opensluice/web",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "icons": "tsx scripts/make-favicons.ts",
    "smoke:tachi": "tsx scripts/tachi-smoke.ts",
    "e2e:tachi": "tsx scripts/tachi-e2e.ts",
    "fund:tachi": "tsx scripts/tachi-fund.ts",
    "pay:tachi": "tsx scripts/tachi-pay.ts"
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@types/node": "^22.10.2",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
