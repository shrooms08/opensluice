{
  "name": "opensluice",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "dev": "npm run dev -w @opensluice/gateway",
    "start": "npm run start -w @opensluice/gateway",
    "build": "npm run build -w @opensluice/web",
    "dev:web": "npm run dev -w @opensluice/web",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "icons": "tsx scripts/make-favicons.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
