# Operator (admin) API key. Sent as: Authorization: Bearer <key>
OPENSLUICE_OPERATOR_KEY=dev_operator_key_change_me

# HMAC-SHA256 key used to sign outgoing webhook bodies (X-OpenSluice-Signature)
OPENSLUICE_WEBHOOK_SECRET=dev_webhook_secret_change_me

# SQLite database file path
OPENSLUICE_DB_PATH=./opensluice.db

# Settlement adapter: "mock" | "tachi".
#   mock  — nothing real moves. The test/demo/CI adapter, and the default.
#   tachi — REAL off-chain settlement on the Tachi ledger; Bitcoin L1 legs are
#           still simulated (see INTEGRATION.md). Requires the block below.
ADAPTER_MODE=mock

# ---- ADAPTER_MODE=tachi only -------------------------------------------------
# BIP-39 mnemonic owning the coordinator's off-chain float and every derived
# LP / swap-leg key. `npm run smoke:tachi` generates and funds one on regtest
# and writes it to .tachi-smoke-state.json (gitignored).
# OPENSLUICE_TACHI_MNEMONIC="abandon abandon ... about"
# OPENSLUICE_TACHI_RPC_URL=https://rpc-regtest.tachibtc.com
# OPENSLUICE_TACHI_NETWORK=regtest          # regtest | signet
# OPENSLUICE_TACHI_STATE_PATH=./tachi-adapter-state.json
# OPENSLUICE_TACHI_API_KEY=                 # only if your daemon requires one
# OPENSLUICE_TACHI_USE_WATCH=false          # WebSocket supplement; polling stays authoritative

# HTTP port
PORT=8080

# Expose unauthenticated POST /dev/swaps/:id/pay-leg/:index (swap-page demo
# buttons). Only honored with ADAPTER_MODE=mock outside production; the
# gateway refuses to boot if this is true with any other adapter.
OPENSLUICE_DEV_PUBLIC_SIMULATE=false

# Optional tuning
# POLL_INTERVAL_MS=1000
# EXPIRY_SWEEP_INTERVAL_MS=5000
# WEBHOOK_SWEEP_INTERVAL_MS=5000
# SSE_HEARTBEAT_MS=15000
# OPENSLUICE_WEB_DIST=/path/to/apps/web/dist
